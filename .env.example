# --- Transcription (captions + b-roll matching) ---
# Provider: "openai" (hosted Whisper) or "local" (whisper CLI on this machine)
TRANSCRIBE_PROVIDER=openai

# Hosted Whisper (TRANSCRIBE_PROVIDER=openai)
OPENAI_API_KEY=
# Optional: point at an OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# WHISPER_MODEL=whisper-1

# Local Whisper (TRANSCRIBE_PROVIDER=local) — pip install openai-whisper
# WHISPER_MODEL=base

# --- B-roll matching (LLM) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
