[Unit]
Description=AutoEditPost LocalCut browser gateway
After=network-online.target localcut-upload.service
Wants=network-online.target

[Service]
Type=simple
User=localcut
Group=localcut
EnvironmentFile=/etc/localcut-web-gateway.env
ExecStart=/usr/bin/node /opt/localcut-web-gateway/server.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
